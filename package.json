  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "yaml": "2.8.1"
  },
  "devDependencies": { "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2", "fflate": "0.8.2" }
}
