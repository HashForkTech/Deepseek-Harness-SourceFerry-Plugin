{
  "name": "deepseek-harness-sourceferry-plugin",
  "version": "1.0.0",
  "description": "SourceFerry search and fetch plugins for DeepSeek Harness, with a complete installer",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "workspaces": ["plugins/local-web-search", "plugins/local-web-fetch"],
